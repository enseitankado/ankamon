          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT time, board AS metric, sum(r) AS value\nFROM (SELECT $__timeGroup(time, '5m') AS time, board, device, avg(rate) AS r\n      FROM (SELECT m.time, b.name AS board, m.device,\n             (m.value - lag(m.value) OVER w) / NULLIF(extract(epoch FROM m.time - lag(m.time) OVER w), 0) AS rate\n      FROM v_metrics m JOIN v_boards b ON b.id = m.board_id AND b.online\n      WHERE $__timeFilter(m.time) AND m.name = 'node_network_receive_bytes_total' AND m.device <> 'lo'\n      WINDOW w AS (PARTITION BY m.board_id, m.device ORDER BY m.time)) s\n      WHERE rate >= 0 GROUP BY 1, 2, 3) t\nGROUP BY 1, 2 ORDER BY 1"
        }
