          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroup(m.time, '15m') AS time, b.name AS metric,\n       (1 - avg(m.value) FILTER (WHERE m.name = 'node_filesystem_avail_bytes')\n          / NULLIF(avg(m.value) FILTER (WHERE m.name = 'node_filesystem_size_bytes'), 0)) * 100 AS value\nFROM v_metrics m JOIN v_boards b ON b.id = m.board_id AND b.online\nWHERE $__timeFilter(m.time) AND m.mountpoint = '/'\n  AND m.name IN ('node_filesystem_avail_bytes', 'node_filesystem_size_bytes')\nGROUP BY 1, 2 ORDER BY 1"
        }
