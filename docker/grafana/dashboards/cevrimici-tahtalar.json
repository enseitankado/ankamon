          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroup(m.time, '5m') AS time, b.name AS metric,\n       (1 - avg(m.value) FILTER (WHERE m.name = 'node_memory_MemAvailable_bytes')\n          / NULLIF(avg(m.value) FILTER (WHERE m.name = 'node_memory_MemTotal_bytes'), 0)) * 100 AS value\nFROM v_metrics m JOIN v_boards b ON b.id = m.board_id AND b.online\nWHERE $__timeFilter(m.time) AND m.name IN ('node_memory_MemAvailable_bytes', 'node_memory_MemTotal_bytes')\nGROUP BY 1, 2 ORDER BY 1"
        }
