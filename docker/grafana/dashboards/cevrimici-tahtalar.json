    {
      "id": 1,
      "type": "timeseries",
      "title": "İşlemci kullanımı",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tihamon"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tihamon"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroup(time, '5m') AS time, board AS metric, (1 - avg(rate)) * 100 AS value\nFROM (SELECT m.time, b.name AS board,\n             (m.value - lag(m.value) OVER w) / NULLIF(extract(epoch FROM m.time - lag(m.time) OVER w), 0) AS rate\n      FROM v_metrics m JOIN v_boards b ON b.id = m.board_id AND b.online\n      WHERE $__timeFilter(m.time) AND m.name = 'node_cpu_seconds_total' AND m.mode = 'idle'\n      WINDOW w AS (PARTITION BY m.board_id, m.cpu ORDER BY m.time)) s\nWHERE rate BETWEEN 0 AND 1.05 GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
