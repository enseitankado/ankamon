          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroup(m.time, '5m') AS time, b.name AS metric, max(m.value) AS value\nFROM v_metrics m JOIN v_boards b ON b.id = m.board_id AND b.online\nWHERE $__timeFilter(m.time) AND m.name IN ('node_hwmon_temp_celsius', 'node_thermal_zone_temp')\n  AND m.value BETWEEN 5 AND 110\nGROUP BY 1, 2 ORDER BY 1"
        }
