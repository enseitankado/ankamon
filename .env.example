# Ankamon ayarları. install.sh bu dosyadan .env üretir ve boş parolaları rastgele doldurur.
# Parolalarda yalnız harf ve rakam kullanın (yapılandırma dosyalarına olduğu gibi gömülür).

TZ=Europe/Istanbul

# --- Ağ ---
# Arayüz portu. 80 başka bir servis tarafından kullanılıyorsa değiştirin.
HTTP_PORT=80
# Tahtaların log göndereceği port (TCP ve UDP). TiHA'daki "Merkezi log sunucusu" adımıyla aynı olmalı.
SYSLOG_PORT=514
# HTTPS portu (arayüz buraya yönlendirilir; "Ekranımı yansıt" HTTPS ister). 0: HTTPS kapalı.
# Sertifika yerel bir CA ile imzalanır: http://<sunucu>/ankamon-ca.crt yönetici bilgisayarına bir kez
# "güvenilen kök sertifika" olarak kurulursa tarayıcı uyarısı çıkmaz.
HTTPS_PORT=443
# Ekran yansıtma: tahtaların yayını okuduğu RTSP portu ve tarayıcının medya (WebRTC ICE) portu (udp+tcp).
CAST_RTSP_PORT=8554
CAST_ICE_PORT=8189

# --- Parolalar (boş bırakılanları install.sh üretir) ---
POSTGRES_PASSWORD=
PG_GRAFANA_PASSWORD=
PG_READONLY_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# etapadmin hesabının ilk parolası; hesap yalnız ilk kurulumda bu değerle oluşturulur.
ETAPADMIN_PASSWORD=

# --- Tahtalara erişim ---
# İlk kurulumda ayarlara tohumlanır; sonrasında arayüzden (Ayarlar → SSH erişimi / Samba erişimi) değiştirilir.
# SSH: uzaktan işlemler, toplu komut ve web terminal bu hesabı kullanır.
BOARD_SSH_USER=root
BOARD_SSH_PASSWORD=
# Samba: şu an yalnız saklanır (TiHA "Dosya sunucusu" adımıyla aynı hesabı tutmak için).
BOARD_SMB_USER=root
BOARD_SMB_PASSWORD=

# --- Veri ---
DATA_DIR=./data
# Yedekleri başka bir diske almak için değiştirin.
BACKUP_DIR=./data/backups
PG_MEMORY=512MB
PG_CPUS=2

# --- Saklama (gün) ---
# Ham (ayrıntılı) sensör verisi; daha eskisi 5 dakikalık ve saatlik özetlere iner.
METRICS_RAW_DAYS=30
METRICS_5M_DAYS=180
METRICS_1H_DAYS=1825
LOG_DAYS=90
# Tahtalardan sensör okuma aralığı.
SCRAPE_INTERVAL=60s

# --- Yedekleme ---
# Yapılandırma yedeği (kullanıcılar, tahtalar, ayarlar, Grafana) kaç saatte bir alınsın.
BACKUP_CONFIG_EVERY_HOURS=6
# Tam yedek (loglar ve sensör verisi dahil) her gün bu saatte alınır.
BACKUP_FULL_AT=03:30
BACKUP_KEEP_CONFIG=28
BACKUP_KEEP_FULL=7
