#!/bin/sh
# Geliştirici güvencesi: public depoya özel içerik gitmesin. Kurulum (depo kökünde, bir kez):
#   cp scripts/git-hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# Engellenen commit'ler:
#  - ext/ altında (ext/README.md dışında) dosya içerenler — eklentiler ayrı depolardır (bkz. ext/README.md);
#  - .git/info/private-words'teki (satır başına bir, büyük/küçük harf duyarsız; depoda DEĞİL) bir kelimeyi
#    commit mesajında ya da değişikliğinde içerenler.
# Yalnız uzakta henüz olmayan commit'ler denetlenir. Engellenirse push hiç yapılmaz.
remote="$1"
words="${PRIVATE_WORDS:-$(git rev-parse --git-common-dir)/info/private-words}"
zero=0000000000000000000000000000000000000000
fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue  # dal silme
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha" 2>/dev/null; then
    commits=$(git rev-list "$local_sha" --not --remotes="$remote")
  else
    commits=$(git rev-list "$remote_sha..$local_sha")
  fi
  for c in $commits; do
    files=$(git diff-tree --no-commit-id --name-only -r --root "$c" | grep '^ext/' | grep -vx 'ext/README.md')
    if [ -n "$files" ]; then
      echo "pre-push ENGEL: $(git log -1 --format='%h %s' "$c") — ext/ altında dosya: $files" >&2
      fail=1
    fi
    if [ -s "$words" ]; then
      found=$(git show --format=%B -p "$c" | grep -o -i -F -f "$words" | sort -u | tr '\n' ' ')
      if [ -n "$found" ]; then
        echo "pre-push ENGEL: $(git log -1 --format='%h %s' "$c") — özel kelime: $found" >&2
        fail=1
      fi
    fi
  done
done
if [ "$fail" != 0 ]; then
  echo "Push reddedildi: özel içerik public depoya gidecekti (bkz. scripts/git-hooks/pre-push)." >&2
  exit 1
fi
exit 0
